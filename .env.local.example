# Bot API Configuration
# Copy this file to .env.local and fill in your values

# URL of the trading bot API (via Cloudflare Tunnel)
NEXT_PUBLIC_BOT_API_URL=https://api.trading.godot.no

# API key for authentication (must match BOT_API_KEY in bot's .env file)
NEXT_PUBLIC_BOT_API_KEY=your_api_key_here
