# Bot API Configuration
# Copy this file to .env.local and fill in your values

# URL of the trading bot API
# Must use NEXT_PUBLIC_ prefix for Next.js to expose to browser
NEXT_PUBLIC_BOT_API_URL=http://192.168.1.120:3847

# API key for authentication (must match BOT_API_KEY in bot's .env file)
NEXT_PUBLIC_BOT_API_KEY=your_api_key_here
